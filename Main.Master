<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.Master.cs" Inherits="GuitarCentre.Site" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guitar Centre | </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="css/my.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="site-body">
    <form id="form1" runat="server" class="site-form">
        <div class="background-aurora" aria-hidden="true"></div>
        <header class="site-header fade-in">
            <div class="branding">
                <asp:ImageButton ID="Logo" runat="server" CssClass="logo" ImageUrl="~/Pics/GuitarCenterlogo.jpg" AlternateText="Guitar Centre" OnClick="Logo_Click" />
                <div class="branding-copy">
                    <span class="brand-title">Guitar Centre</span>
                    <span class="brand-tagline">Play. Perform. Perfect.</span>
                </div>
            </div>
            <div class="header-actions">
                <span class="header-badge">Since 1996</span>
            </div>
        </header>
        <nav class="site-nav">
            <div class="nav-inner">
                <ul class="nav-links">
                    <li><a href="HomePage.aspx">Home</a></li>
                    <li><a href="Products.aspx">Products</a></li>
                    <li><a href="Manufactor.aspx">Manufactor</a></li>
                    <li><a href="Clients.aspx">Clients</a></li>
                    <li><a href="Employees.aspx">Employees</a></li>
                    <li><a href="Sales.aspx">Sales</a></li>
                </ul>
            </div>
        </nav>
        <main class="page-content fade-up">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </main>
        <footer class="site-footer fade-in">
            <div class="footer-inner">
                <span>© Guitar Centre Ltd.</span>
                <span class="footer-accent">Crafting memorable performances.</span>
            </div>
        </footer>
    </form>
</body>
</html>
